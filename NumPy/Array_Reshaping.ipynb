      " [5 6]] (3, 2)\n"
     ]
    }
   ],
   "source": [
    "# Reshaping in Arrays\n",
    "\n",
    "arr = np.array([[1, 2, 3], [4, 5, 6]])\n",
    "print(arr, arr.shape)\n",
    "\n",
    "reshaped = arr.reshape((3, 2))\n",
    "print(reshaped, reshaped.shape)"
   ]
  },
